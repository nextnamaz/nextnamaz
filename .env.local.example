# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon key — used only to subscribe to realtime broadcast channels.
# It has no table access: the screens table has RLS on with no policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-side only. All database reads and writes use this.
SUPABASE_SERVICE_ROLE_KEY=
